+    @contextmanager
+    def rollout_session(self):
+        """Keep unchanged weights/cache resident until the full tool group exits.
+
+        Normal and exceptional exits release inference memory before scoring or
+        optimization. Nested scopes release once. Defaults retain upstream behavior.
+        """
+        if not (self.mode == "colocate" and self.enable_sleep_mode and self.rollout_residency):
+            yield
+            return
+        self._rollout_session_depth += 1
+        try:
+            yield
+        finally:
+            self._rollout_session_depth -= 1
+            if self._rollout_session_depth == 0:
+                self.llm.sleep(level=2)
+                self._llm_weights_sleeping = True
+                self._llm_kv_cache_sleeping = True
 
