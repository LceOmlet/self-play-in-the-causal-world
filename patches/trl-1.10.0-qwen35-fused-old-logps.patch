+    ) -> bool:
+        """Return whether the exact Liger selected-token log-probability path is supported."""
+        if not self.use_liger_kernel or compute_entropy or compute_aux_loss or self.temperature != 1.0:
+            return False
+        if any(
+            value is not None
+            for value in (
