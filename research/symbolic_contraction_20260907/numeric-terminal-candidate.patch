+    def _compile_numeric_terminal_factors(
+        self,
+    ) -> tuple[list[_SymbolicFactor], frozenset[int]] | None:
+        """Integrate shared variables absent from every unknown mechanism.
+
+        A certified terminal endpoint is already a numeric cost. Shared
+        variables read only by that cost and the shared CPTs can therefore be
+        summed out before multiplying any response kernel. The same kernel
+        variables remain shared across all surviving contexts.
+        """
+        if self.terminal_event_endpoint is None:
+            return None
+        boundary = {
+            parent
+            for node in self.mechanism_affected
+            for parent in self.world.parents[node]
+            if parent in self.shared
+        }
+        nuisance = frozenset(set(self.shared) - boundary)
+        if not nuisance:
+            return None
+        factors = [self._terminal_event_factor(), *(self._shared_factor(n) for n in self.shared)]
+        scopes = [factor.scope for factor in factors]
+        remaining = set(nuisance)
+        order = []
+        while remaining:
+            choices = []
+            for node in remaining:
+                token = (node, -1)
+                union = tuple(
+                    sorted({t for scope in scopes if token in scope for t in scope} - {token})
+                )
+                cells = int(np.prod([self.world.domains[t[0]] for t in union], dtype=object))
+                choices.append((cells, node, union))
+            _, node, union = min(choices)
+            scopes = [scope for scope in scopes if (node, -1) not in scope] + [union]
+            remaining.remove(node)
+            order.append(node)
+        unit_values = {(): 1.0}
+        unit_projection = _ProjectedFactor((), unit_values)
+        unit = _SymbolicFactor(
+            (),
+            unit_values,
+            unit_values,
+            unit_values,
+            left_projection=unit_projection,
+            right_projection=unit_projection,
+        )
+        for node in order:
+            factors = _eliminate_factor_tokens(
+                self.world,
+                self.model,
+                factors,
+                ((node, -1),),
+                unit,
+                outcome=self.outcome,
+                outcome_state=self.outcome_state,
+                outcome_events=self.outcome_events,
+                auxiliary_values=self.auxiliary_values,
+                probability_message_bounds=self.probability_message_bounds,
+                projected_message_bounds=self.projected_message_bounds,
+                projected_bound_diagnostics=self.projected_bound_diagnostics,
+            )
+        return factors, nuisance
